[
  {
    "item_code": "EG13",
    "type": "classement",
    "lecon": {
      "titre": "Reconnaitre un polygone",
      "regle": "Un polygone est une figure fermée dont tous les côtés sont des segments droits.",
      "procedure": [
        "Fais le tour de la figure avec ton doigt : reviens-tu à ton point de départ ?",
        "Regarde ensuite chaque côté : tous doivent être des traits droits, sans arrondi.",
        "Si les deux réponses sont oui, c'est un polygone."
      ],
      "exemples": [
        {
          "phrase": "Le contour d'une enveloppe posée à plat.",
          "demonstration": "Je fais le tour : je reviens au départ, elle est fermée. Chaque côté est un trait droit. C'est un polygone."
        },
        {
          "phrase": "Une ligne brisée de 3 segments dont les deux bouts ne se rejoignent pas.",
          "demonstration": "Tous les traits sont droits, mais je ne reviens pas au départ : la figure n'est pas fermée, ce n'est pas un polygone."
        }
      ],
      "piege": "Un rond est bien fermé, mais son contour n'est pas fait de segments : ce n'est pas un polygone."
    },
    "diagnostic": [
      {
        "question": "Rosalie a tracé une figure fermée avec 11 traits droits, tous tirés à la règle. Comment appelle-t-on cette figure ?",
        "options": [
          "un polygone",
          "une ligne brisée ouverte",
          "un cercle",
          "une courbe"
        ],
        "reponse_correcte": 0,
        "explication": "Elle est fermée et tous ses côtés sont des segments droits : c'est un polygone. Le nombre de côtés n'a pas d'importance."
      },
      {
        "question": "Timéo dit : « Toutes les figures fermées sont des polygones. » A-t-il raison ?",
        "options": [
          "Oui, il suffit qu'une figure soit fermée.",
          "Non : il faut aussi que tous les côtés soient des segments droits.",
          "Non : il faut aussi qu'elle ait exactement 4 côtés.",
          "Oui, sauf si elle a plus de 6 côtés."
        ],
        "reponse_correcte": 1,
        "explication": "Être fermée ne suffit pas : un rond est fermé et n'est pas un polygone. Il faut en plus que chaque côté soit un segment droit."
      }
    ],
