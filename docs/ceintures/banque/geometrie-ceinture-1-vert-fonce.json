  {
    "item_code": "EG14",
    "type": "exercice",
    "lecon": {
      "titre": "Compter les axes de symétrie",
      "regle": "Un axe de symétrie est un pli qui partage la figure en deux moitiés qui se superposent exactement.",
      "procedure": [
        "Cherche un pli qui rabat la figure exactement sur elle-même.",
        "Essaie le pli vertical, le pli horizontal, puis les plis penchés : un axe peut aller dans n'importe quelle direction.",
        "Compte les plis qui marchent : c'est le nombre d'axes."
      ],
      "exemples": [
        {
          "phrase": "La lettre A dessinée sur le quadrillage.",
          "demonstration": "Le pli vertical du milieu rabat la moitié gauche sur la moitié droite : il marche. Les autres plis, non. La lettre A a 1 axe de symétrie."
        },
        {
          "phrase": "La lettre H dessinée sur le quadrillage.",
          "demonstration": "Ici le pli vertical marche, et le pli horizontal aussi. Les plis en diagonale, non. La lettre H a donc 2 axes de symétrie."
        }
      ],
      "piege": "Ne t'arrête pas aux plis vertical et horizontal : un axe peut être penché dans n'importe quelle direction."
    },
    "diagnostic": [
      {
        "question": "Malo plie une figure en deux le long d'un trait. Les deux moitiés se recouvrent exactement. Que peut-il dire de ce trait ?",
        "options": [
          "C'est un côté de la figure.",
          "C'est un axe de symétrie de la figure.",
          "C'est une diagonale, mais pas un axe de symétrie.",
          "C'est le milieu d'un côté de la figure."
        ],
        "reponse_correcte": 1,
        "explication": "Quand le pli fait se superposer exactement les deux moitiés, ce pli est un axe de symétrie."
      },
      {
        "question": "Nour essaie tous les plis sur une figure : le pli vertical marche, le pli horizontal marche, et les deux plis en diagonale marchent aussi. Combien d'axes de symétrie a cette figure ?",
        "options": [
          "1",
          "2",
          "3",
          "4"
        ],
        "reponse_correcte": 3,
        "explication": "Chaque pli qui fait se superposer les deux moitiés est un axe de symétrie : ici il y en a 4. L'erreur la plus fréquente est d'oublier de compter les plis en diagonale."
      }
    ],
