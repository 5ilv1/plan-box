    "type": "exercice",
    "lecon": {
      "titre": "Cases et nœuds",
      "regle": "Une case se repère par une lettre et un chiffre (B4), un nœud par deux nombres (4;2).",
      "procedure": [
        "Regarde si on demande une case (un carreau) ou un nœud (un coin de carreau).",
        "Pour une case, compte les colonnes depuis la gauche (A, B, C…) puis les lignes depuis le bas.",
        "Pour un nœud, pars du nœud (0;0), en bas à gauche : compte à droite, puis en haut."
      ],
      "exemples": [
        {
          "phrase": "Le pion de Rosalie est dans la 4e colonne, sur la 3e ligne.",
          "demonstration": "La 4e colonne est la colonne D : le pion est dans la case D3."
        },
        {
          "phrase": "Le point T est à 6 carreaux à droite du nœud (0;0), et 1 plus haut.",
          "demonstration": "D'abord les pas vers la droite, puis ceux vers le haut : T est le nœud (6;1)."
        }
      ],
      "piege": "Pour une case, la lettre avant le chiffre ; pour un nœud, la droite avant le haut."
    },
    "diagnostic": [
      {
        "question": "Sur un quadrillage, les colonnes sont nommées A, B, C… depuis la gauche et les lignes 1, 2, 3… depuis le bas. Le jeton de Jade est dans la troisième colonne, sur la deuxième ligne. Quelle est sa case ?",
        "options": [
          "B3",
          "C2",
          "3C",
          "2C"
        ],
        "reponse_correcte": 1,
        "explication": "La troisième colonne est la colonne C, la deuxième ligne porte le numéro 2 : la case est C2. On écrit toujours la lettre avant le chiffre."
      },
      {
        "question": "Sur un quadrillage, le coin en bas à gauche est le nœud (0;0). Le point R se trouve 5 carreaux à droite et 2 carreaux plus haut. Quelles sont ses coordonnées ?",
        "options": [
          "(2;5)",
          "(5;0)",
          "(0;5)",
          "(5;2)"
        ],
        "reponse_correcte": 3,
        "explication": "On écrit d'abord les carreaux vers la droite, puis ceux vers le haut : (5;2). Le nœud (2;5) est un tout autre nœud."
      }
    ],
