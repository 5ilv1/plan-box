    "lecon": {
      "titre": "Compléter à 10, 100 et 1 000",
      "regle": "Le complément d'un nombre, c'est ce qu'il faut ajouter pour atteindre 10, 100 ou 1 000.",
      "procedure": [
        "Pour aller à 10, cherche ce qui manque au chiffre.",
        "Pour aller à 100 : si le nombre finit par un zéro, compte de dizaine en dizaine ; sinon, complète les unités jusqu'à 10 et les dizaines jusqu'à 9.",
        "Pour aller à 1 000, monte à la centaine ronde, puis complète les centaines."
      ],
      "exemples": [
        {
          "phrase": "Complément de 64 à 100",
          "demonstration": "Unités : 4 + 6 = 10. Dizaines : 6 + 3 = 9. Le complément est 36."
        },
        {
          "phrase": "Complément de 250 à 1 000",
          "demonstration": "Je monte à 300 avec 50, puis de 300 à 1 000 avec 700 : en tout 750."
