    "lecon": {
      "titre": "Vérifier les tables de 3, 4 et 6",
      "regle": "Une table se sait par cœur : ici, on vérifie seulement que tu la sais.",
      "procedure": [
        "Pour apprendre tes tables de 3, 4 et 6, entraîne-toi avec le module Ceintures de multiplication, jusqu'à la ceinture Vert clair.",
        "Si un résultat te manque, récite la table jusqu'à lui.",
        "Souviens-toi qu'on peut échanger les deux nombres : le résultat ne change pas."
      ],
      "exemples": [
        {
          "phrase": "6 × 7",
          "demonstration": "J'avance de 6 en 6 et je compte les pas : au septième pas, j'arrive à 42."
        },
        {
          "phrase": "8 × 4",
          "demonstration": "Je sais que 4 × 8 = 32 ; l'ordre ne change rien : 8 × 4 = 32."
        }
      ],
      "piege": "6 × 7 = 42 : ne le confonds pas avec 6 × 8, qui va plus loin dans la table.",
