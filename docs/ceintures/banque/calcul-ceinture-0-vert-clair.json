    "lecon": {
      "titre": "Poser une soustraction",
      "regle": "Dans une soustraction posée, on retire chiffre par chiffre en partant des unités ; ici, aucun chiffre du bas n'est plus grand que celui du haut.",
      "procedure": [
        "Écris le plus grand nombre en haut, unités sous unités.",
        "Soustrais colonne par colonne en partant de la droite.",
        "Écris chaque résultat sous le trait."
      ],
      "exemples": [
        {
          "phrase": "89 − 47",
          "demonstration": "9 − 7 = 2, puis 8 − 4 = 4. Il reste 42."
        },
        {
          "phrase": "497 − 254",
          "demonstration": "7 − 4 = 3, puis 9 − 5 = 4, puis 4 − 2 = 2. Il reste 243 : avec trois chiffres, une colonne après l'autre."
