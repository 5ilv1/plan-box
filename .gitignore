# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Worktrees créés par le harness — ne pas tracker
.claude/worktrees/

# Sauvegardes locales avant remise à zéro d'année
backups/

# Audit sécurité : décrit des failles encore ouvertes sur une app en ligne.
# Le dépôt est public — ce fichier ne doit jamais y être poussé.
docs/securite/
