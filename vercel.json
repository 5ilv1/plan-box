      "schedule": "0 6 * * 1,2,4,5"
    },
    {
      "path": "/api/cron/calcul-du-jour",
      "schedule": "10 6 * * 1,2,4,5"
    }
  ],
  "rewrites": [
    {
      "source": "/media/:path*",
